NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=al_fataax_education
DB_USER=root
DB_PASSWORD=

JWT_SECRET=replace-with-a-long-random-string
# Inactivity timeout: the token/cookie is only refreshed by an explicit
# heartbeat ping the frontend sends on real user activity (see
# POST /api/auth/heartbeat), never by ordinary/background requests. So this
# value IS the enforced idle timeout — it must match the frontend's
# IDLE_TIMEOUT_MS in client/src/config/session.js. Accepts Ns / Nm / Nh / Nd.
JWT_EXPIRES_IN=60s

COOKIE_NAME=af_token

# Forgot Password OTP email — Gmail SMTP with an App Password (requires
# 2-Step Verification enabled on the Google account; generate one at
# https://myaccount.google.com/apppasswords). NOT your normal Gmail
# password. Optional at boot — only the Forgot Password email step fails
# until these are set.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM=your-gmail-address@gmail.com
