NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=al_fataax_education
DB_USER=root
DB_PASSWORD=

JWT_SECRET=replace-with-a-long-random-string
# Inactivity timeout: the token/cookie is only refreshed by an explicit
# heartbeat ping the frontend sends on real user activity (see
# POST /api/auth/heartbeat), never by ordinary/background requests. So this
# value IS the enforced idle timeout — it must match the frontend's
# IDLE_TIMEOUT_MS in client/src/config/session.js. Accepts Ns / Nm / Nh / Nd.
JWT_EXPIRES_IN=60s

COOKIE_NAME=af_token
