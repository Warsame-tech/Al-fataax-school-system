NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=al_fataax_education
DB_USER=root
DB_PASSWORD=

JWT_SECRET=replace-with-a-long-random-string
# Idle timeout: session slides forward on activity, expires this long after
# the last request if the user walks away. Accepts Ns / Nm / Nh / Nd.
JWT_EXPIRES_IN=15m

COOKIE_NAME=af_token
